theme = Catppuccin Mocha
shell-integration-features = ssh-terminfo,ssh-env
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true
mouse-hide-while-typing = true
confirm-close-surface = false
font-size = 16
keybind = shift+enter=text:\x1b\r

# Cursor trail shader
custom-shader = shaders/cursor_blaze.glsl
custom-shader-animation = true
cursor-style = block
cursor-color = #f5f0c4

# Pin symbol glyphs that rendered as letters (check, star, checkbox) inside herdr
# after the Ghostty 1.4.0 update. Remove these two lines to undo.
font-codepoint-map = U+2714-U+27BF=Zapf Dingbats
font-codepoint-map = U+2610-U+2612=Apple Symbols

