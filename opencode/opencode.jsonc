{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "supabase": "deny",
      "supabase *": "deny",
      "bunx supabase": "deny",
      "bunx supabase *": "deny",
      "bun x supabase": "deny",
      "bun x supabase *": "deny",
      "npx supabase": "deny",
      "npx supabase *": "deny",
      "npm exec supabase": "deny",
      "npm exec supabase *": "deny",
      "pnpm dlx supabase": "deny",
      "pnpm dlx supabase *": "deny",
      "yarn dlx supabase": "deny",
      "yarn dlx supabase *": "deny",
      "./node_modules/.bin/supabase": "deny",
      "./node_modules/.bin/supabase *": "deny",
      "*/supabase": "deny",
      "*/supabase *": "deny"
    }
  }
}
